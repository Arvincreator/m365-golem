{
  "name": "m365-golem",
  "version": "0.1.0",
  "description": "Local Microsoft 365 Copilot Web harness with projects, tools, approvals, memory, and a built-in SharePoint/OneDrive session bridge",
  "main": "index.js",
  "scripts": {
    "test": "jest",
    "test:coverage": "jest --coverage --runInBand",
    "test:security": "jest tests/safeguard.test.js",
    "arch:check": "node scripts/check-architecture-boundaries.js",
    "audit:prod": "npm audit --omit=dev --audit-level=high",
    "build": "cd web-dashboard && npm run build",
    "// --- 核心啟動 ---": "",
    "start": "node --expose-gc apps/runtime/index.js",
    "dashboard": "node --expose-gc apps/runtime/index.js dashboard",
    "dev": "nodemon --expose-gc apps/runtime/index.js dashboard",
    "doctor": "node scripts/doctor.js",
    "doctor:runtime": "node scripts/runtime-check.js doctor",
    "repair:runtime": "node scripts/runtime-check.js repair",
    "smoke:runtime": "node scripts/runtime-check.js smoke",
    "smoke:runtime:start": "node scripts/runtime-check.js smoke --with-start",
    "runtime:all": "node scripts/runtime-check.js all",
    "install:m365": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/install-m365-golem.ps1",
    "install:m365:plan": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/install-m365-golem.ps1 -PlanOnly",
    "bridge:install": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/install-m365-session-bridge.ps1",
    "bridge:plan": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/install-m365-session-bridge.ps1 -PlanOnly",
    "bridge:build": "npm --prefix integrations/m365-session-bridge run build",
    "bridge:test": "npm --prefix integrations/m365-session-bridge test",
    "// --- Windows 安裝入口 ---": "",
    "win:setup": "Install-M365-Golem.bat",
    "// --- 自動化 ---": "",
    "postinstall": "echo [INFO] M365 Golem dependencies installed."
  },
  "keywords": [
    "golem",
    "microsoft-365",
    "copilot-web",
    "edge",
    "mcp",
    "sharepoint",
    "onedrive",
    "local-harness"
  ],
  "author": "Arvin Chen",
  "license": "LicenseRef-Project-Golem-NonCommercial",
  "dependencies": {
    "@google/generative-ai": "0.21.0",
    "@lancedb/lancedb": "^0.26.2",
    "@xenova/transformers": "^2.17.2",
    "adm-zip": "^0.5.16",
    "apache-arrow": "^18.1.0",
    "blessed": "0.1.81",
    "blessed-contrib": "4.11.0",
    "chrome-devtools-mcp": "^0.25.0",
    "cors": "^2.8.6",
    "discord.js": "^14.25.1",
    "dotenv": "16.4.5",
    "express": "5.2.1",
    "grammy": "^1.41.1",
    "jiti": "^2.6.1",
    "memory-lancedb-pro": "^1.1.0-beta.9",
    "opossum": "^9.0.0",
    "playwright": "^1.42.1",
    "socket.io": "4.8.3",
    "socket.io-client": "4.8.3",
    "sqlite3": "^6.0.1",
    "uuid": "9.0.1"
  },
  "devDependencies": {
    "jest": "^30.3.0",
    "nodemon": "3.0.2"
  },
  "overrides": {
    "undici": "^6.24.1",
    "xml2js": "^0.6.2"
  },
  "engines": {
    "node": ">=20"
  }
}
