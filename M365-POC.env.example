# Microsoft 365 Copilot Chat Web POC
# This profile uses the visible Edge web app. It does not call Copilot Chat API.
GOLEM_BACKEND=m365-web
GOLEM_PREWARM_ON_BOOT=true

PLAYWRIGHT_PROFILE=m365-work
PLAYWRIGHT_HEADLESS=false
PLAYWRIGHT_M365_BROWSER_CHANNEL=msedge
PLAYWRIGHT_M365_STEALTH_ENABLED=false
PLAYWRIGHT_M365_BLOCK_HEAVY_RESOURCES=false

M365_COPILOT_URLS=https://m365.cloud.microsoft/chat
M365_POC_SAFE_MODE=true
M365_LOCAL_MEMORY_ENABLED=false
M365_ACTIONS_ENABLED=false
M365_AUTO_BOOT_PROMPT=false
M365_PAGE_READY_TIMEOUT_MS=20000
M365_RESPONSE_TIMEOUT_MS=60000

# Local project, conversation, checkpoint, and approval records are encrypted at rest.
M365_WORKSPACE_ENABLED=true
M365_RUNNER_ENABLED=true
M365_WORKSPACE_DB_PATH=data/m365-workspace.sqlite
# The launcher generates this key locally and never prints it. Do not share or commit it.
M365_DATA_ENCRYPTION_KEY=

GOLEM_AUTONOMY_ENABLED=false
GOLEM_REFLECTION_ENABLED=false
ALLOW_REMOTE_ACCESS=false

# Keep external message gateways off for the first local Dashboard validation.
TELEGRAM_TOKEN=
DISCORD_TOKEN=
