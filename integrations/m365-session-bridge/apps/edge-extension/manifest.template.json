{
  "manifest_version": 3,
  "name": "M365 Session Bridge",
  "version": "0.1.0",
  "description": "Lets M365 Golem perform an approved set of SharePoint/OneDrive for Business file actions through your existing signed-in Edge session. It never reads, stores, or transmits your Microsoft password, cookies, or access tokens.",
  "permissions": ["nativeMessaging", "scripting", "alarms"],
  "host_permissions": ["__HOST_PERMISSIONS_PLACEHOLDER__"],
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "minimum_chrome_version": "95",
  "key": ""
}
